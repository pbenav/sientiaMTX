{
    "type": "document",
    "display_name": "Documento",
    "description": "Actividad para gestionar documentos y archivos",
    "icon": "icon-file",
    "color": "#2ecc71",
    "properties": {
        "title": {
            "type": "string",
            "required": true,
            "max_length": 255,
            "searchable": true
        },
        "description": {
            "type": "text",
            "required": false,
            "max_length": 1000000,
            "searchable": true
        },
        "file_path": {
            "type": "string",
            "required": false,
            "max_length": 1000
        },
        "file_size": {
            "type": "integer",
            "required": false
        },
        "mime_type": {
            "type": "string",
            "required": false,
            "max_length": 255
        },
        "version": {
            "type": "string",
            "required": false,
            "default": "1.0.0",
            "max_length": 20
        },
        "is_ephemeral": {
            "type": "boolean",
            "required": false,
            "default": false
        },
        "chapters": {
            "type": "array",
            "required": false,
            "default": []
        },
        "status": {
            "type": "string",
            "required": false,
            "default": "draft",
            "enum": [
                "draft",
                "review",
                "approved",
                "rejected",
                "published",
                "archived"
            ]
        }
    },
    "states": {
        "draft": {
            "transitions": [
                "review",
                "approved",
                "rejected",
                "archived"
            ]
        },
        "review": {
            "transitions": [
                "draft",
                "approved",
                "rejected",
                "archived"
            ]
        },
        "approved": {
            "transitions": [
                "published",
                "archived",
                "draft",
                "review"
            ]
        },
        "rejected": {
            "transitions": [
                "draft",
                "archived"
            ]
        },
        "published": {
            "transitions": [
                "archived",
                "draft"
            ]
        },
        "archived": {
            "transitions": [
                "draft"
            ]
        }
    },
    "conversions": {
        "allowed_targets": [
            "task",
            "note"
        ],
        "property_mapping": {
            "title": "title",
            "description": "description"
        },
        "preserve_metadata": [
            "tags",
            "assignments",
            "attachments"
        ]
    },
    "actions": {
        "create": true,
        "update": true,
        "delete": true,
        "convert": true,
        "archive": true,
        "assign": true,
        "rate": true
    }
}